{
  "name": "react-property-tests",
  "version": "0.1.0",
  "description": "Property-based testing framework for React with focus on interaction sequences",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
